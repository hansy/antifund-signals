{
  "name": "antifund-signals",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3010 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3010",
    "typecheck": "tsc --noEmit",
    "test": "bun test src tests",
    "deploy": "bun run build && wrangler deploy",
    "convex:dev": "convex dev",
    "format": "prettier --write src tests convex data README.md"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.10",
    "@tanstack/react-start": "^1.168.18",
    "convex": "^1.35.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "convex-test": "^0.0.60",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "wrangler": "^4.120.0"
  }
